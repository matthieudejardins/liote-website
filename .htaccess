# =============================================================
# Lioté — Apache configuration for Gandi Simple Hosting
# =============================================================

# --------------------------------------------------------------
# 1. HTTPS + redirects
# --------------------------------------------------------------
# HTTP -> HTTPS is NOT done here: on Gandi Web Hosting, TLS ends at the web
# accelerator, so %{HTTPS} is never "on" in Apache (redirect loop). It is set
# on the vhost instead (https_strategy = redirect_HTTP_to_HTTPS).
# www.liote.fr -> liote.fr is a Gandi Web Forwarding (the plan allows 1 vhost).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: redirect www -> apex (only reached if www ever hits this vhost)
  RewriteCond %{HTTP_HOST} ^www\.liote\.fr$ [NC]
  RewriteRule ^ https://liote.fr%{REQUEST_URI} [L,R=301]

  # Legacy blog URL: clear-channel renamed to cityz-media
  RewriteRule ^blog/clear-channel-palais-des-congres\.html$ https://liote.fr/blog/cityz-media-palais-des-congres.html [L,R=301]

  # Legacy Squarespace URLs (old www.liote.fr sitemap, 21/10/2026)
  RewriteRule ^accueil/?$ https://liote.fr/ [L,R=301]
  RewriteRule ^test-hp/?$ https://liote.fr/ [L,R=301]
  RewriteRule ^nouveau-dossier/?$ https://liote.fr/ [L,R=301]
  RewriteRule ^contact/?$ https://liote.fr/contact.html [L,R=301]
  RewriteRule ^(histoire-publicite-marques|notre-histoire-1)/?$ https://liote.fr/notre-histoire.html [L,R=301]
  RewriteRule ^liote/patrimoine/toiles-publicitaires/?$ https://liote.fr/renovation-patrimoine.html [L,R=301]
  RewriteRule ^activite-liote/toile-evenementielle/?$ https://liote.fr/toiles-evenementielles.html [L,R=301]
  RewriteRule ^test-galerie-toiles-event/?$ https://liote.fr/toiles-evenementielles.html [L,R=301]
  RewriteRule ^activite-liote/affichage-premium-palais-des-congres-paris/?$ https://liote.fr/affichage-premium.html [L,R=301]
  RewriteRule ^test-palais-galerie/?$ https://liote.fr/affichage-premium.html [L,R=301]
  RewriteRule ^activite-liote/publicite-lumineuse/?$ https://liote.fr/publicites-lumineuses.html [L,R=301]
  RewriteRule ^activite-liote/?$ https://liote.fr/solutions.html [L,R=301]
</IfModule>

# --------------------------------------------------------------
# 2. Security headers
# --------------------------------------------------------------
<IfModule mod_headers.c>
  # No includeSubDomains: webmail.liote.fr / blog.liote.fr have no valid HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-src https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://*.analytics.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;"
</IfModule>

# --------------------------------------------------------------
# 3. Compression (Gzip / Brotli)
# --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2 font/woff
</IfModule>

# --------------------------------------------------------------
# 4. Browser caching
# --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — short cache, must revalidate
  ExpiresByType text/html                     "access plus 0 seconds"

  # CSS / JS — 1 hour (file names are not versioned, edits must show up)
  ExpiresByType text/css                      "access plus 1 hour"
  ExpiresByType application/javascript        "access plus 1 hour"
  ExpiresByType text/javascript               "access plus 1 hour"

  # Images / video — 1 year
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType video/mp4                     "access plus 1 year"
  ExpiresByType video/webm                    "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long cache for media and fonts
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico|mp4|webm|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Short cache for CSS / JS (not versioned)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # No cache for HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------
# 5. Custom error page
# --------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------
# 6. Disallow listing folders
# --------------------------------------------------------------
Options -Indexes

# --------------------------------------------------------------
# 7. Block sensitive files
# --------------------------------------------------------------
<FilesMatch "(^\.|\.(md|yml|yaml|json|gitignore|DS_Store)$)">
  Require all denied
</FilesMatch>
